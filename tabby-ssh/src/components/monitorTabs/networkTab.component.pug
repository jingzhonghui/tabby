.network-container
  .alert.alert-danger(*ngIf='error')
    i.fas.fa-exclamation-triangle.me-2
    | {{error}}

  .network-metrics(*ngIf='!loading && !error')
    .metric-card
      .metric-label
        i.fas.fa-arrow-down
        span 接收速度
      .metric-value {{formatBytesPerSecond(totalRxSpeed)}}
      .metric-sub 总计

    .metric-card
      .metric-label
        i.fas.fa-arrow-up
        span 发送速度
      .metric-value {{formatBytesPerSecond(totalTxSpeed)}}
      .metric-sub 总计

    .metric-card
      .metric-label
        i.fas.fa-download
        span 接收总量
      .metric-value {{formatBytes(totalRxBytes)}}

    .metric-card
      .metric-label
        i.fas.fa-upload
        span 发送总量
      .metric-value {{formatBytes(totalTxBytes)}}

  .chart-section(*ngIf='!error')
    .chart-title
      i.fas.fa-chart-area
      span 网络流量趋势 (60秒)
    .chart-loading(*ngIf='history.length < 2')
      i.fas.fa-circle-notch.fa-spin
      span 正在加载趋势数据...
    canvas.chart-canvas(#trendCanvas, *ngIf='history.length >= 2')

  .interface-section(*ngIf='!error')
    .section-title
      i.fas.fa-network-wired
      span 网络接口详情
    .interface-list-scroll
      .section-loading(*ngIf='interfaces.length === 0 && (fetching || fetchAttempts < 3)')
        i.fas.fa-circle-notch.fa-spin
        span 正在加载接口数据...
      .interface-list(*ngIf='interfaces.length > 0')
        .interface-card(*ngFor='let iface of interfaces; trackBy: trackByName')
          .interface-header
            .interface-name
              i.fas.fa-ethernet
              | {{iface.name}}
          .interface-stats
            .stat
              .stat-label 接收速度
              .stat-value {{formatBytesPerSecond(iface.rxSpeed)}}
            .stat
              .stat-label 发送速度
              .stat-value {{formatBytesPerSecond(iface.txSpeed)}}
            .stat
              .stat-label 接收包数
              .stat-value {{iface.rxPackets}}
            .stat
              .stat-label 发送包数
              .stat-value {{iface.txPackets}}
      .empty-state(*ngIf='interfaces.length === 0 && !fetching && fetchAttempts >= 3')
        i.fas.fa-inbox
        span 暂无接口数据
