.header
    .monitor-tabs(#tabContainer, (wheel)='onTabWheel($event)')
        button.tab-btn(
            *ngFor='let tab of tabs',
            [class.active]='activeTab === tab.id',
            (click)='switchTab(tab.id)'
        )
            i.fas([class]='tab.icon')
            span {{tab.label}}

    .ms-auto
    button.btn.btn-link.text-decoration-none((click)='close()')
        i.fas.fa-times

.body
    overview-tab(
        *ngIf='activeTab === "overview"',
        [session]='session',
        (statsChange)='onStatsUpdated($event)'
    )
    cpu-tab(
        *ngIf='activeTab === "cpu"',
        [session]='session'
    )
    memory-tab(
        *ngIf='activeTab === "memory"',
        [session]='session'
    )
    disk-tab(
        *ngIf='activeTab === "disk"',
        [session]='session'
    )
    network-tab(
        *ngIf='activeTab === "network"',
        [session]='session'
    )
