.modal-header
    h3.m-0 {{group.name}}

.modal-body
    .row
        .col-12.col-lg-4
            .mb-3
                label(translate) Name
                input.form-control(
                    type='text',
                    autofocus,
                    [(ngModel)]='group.name',
                )

            .mb-3
                label(translate) Parent Group
                select.form-control(
                    [(ngModel)]='parentSelection',
                )
                    option([ngValue]='""', translate) Ungrouped
                    option(*ngFor='let group of groups', [ngValue]='group.id') {{ getGroupLabel(group) }}

            .mb-3
                label(translate) Icon
                .input-group
                    input.form-control(
                        type='text',
                        alwaysVisibleTypeahead,
                        [(ngModel)]='group.icon',
                        [ngbTypeahead]='iconSearch',
                        [resultTemplate]='rt'
                    )
                    .input-group-text
                        profile-icon(
                            [icon]='group.icon',
                            [color]='group.color'
                        )

                ng-template(#rt,let-r='result',let-t='term')
                    i([class]='"fa-fw " + r')
                    ngb-highlight.ms-2([result]='r', [term]='t')

            .mb-3.group-color
                label(translate) Color
                .color-swatches
                    button.color-swatch(
                        type='button',
                        *ngFor='let c of presetColors',
                        [class.selected]='isSelectedColor(c.value)',
                        [style.background]='c.value',
                        [title]='c.name|translate',
                        (click)='selectColor(c.value)'
                    )
                    button.color-swatch.color-none(
                        type='button',
                        [class.selected]='!group.color',
                        [title]='"No color"|translate',
                        (click)='selectColor(null)'
                    )
                        i.fas.fa-ban
                    button.color-swatch.color-custom(
                        type='button',
                        [class.selected]='isCustomColor()',
                        [class.open]='customPanelOpen',
                        [style.background]='isCustomColor() ? group.color : null',
                        [title]='"Custom"|translate',
                        (click)='toggleCustomPanel()'
                    )
                        i.fas.fa-eye-dropper(*ngIf='!isCustomColor()')

                .color-panel(*ngIf='customPanelOpen')
                    .color-area(
                        (pointerdown)='onAreaPointerDown($event)',
                        [style.background-color]='hueColor'
                    )
                        .color-area-thumb(
                            [style.left.%]='hsv.s * 100',
                            [style.top.%]='(1 - hsv.v) * 100'
                        )
                    .color-hue((pointerdown)='onHuePointerDown($event)')
                        .color-hue-thumb([style.left.%]='hsv.h / 3.6')

                .color-value
                    span.color-preview([style.background]='group.color')
                    input.form-control(
                        type='text',
                        [ngModel]='group.color',
                        (ngModelChange)='onHexChange($event)',
                        placeholder='#RRGGBB'
                    )

        .col-12.col-lg-8(*ngIf='providers.length !== 0')
            .form-line.content-box
                .header
                    .title(translate) Default profile group settings
                    .description(translate) These apply to all profiles of a given type in this group

            .list-group.mt-3.mb-3.content-box
                a.list-group-item.list-group-item-action.d-flex.align-items-center(
                    (click)='editDefaults(provider)',
                    *ngFor='let provider of providers'
                ) {{provider.name|translate}}
                    .me-auto
                    button.btn.btn-link.hover-reveal.ms-1((click)='$event.stopPropagation(); deleteDefaults(provider)')
                        i.fas.fa-trash-arrow-up

.modal-footer
    button.btn.btn-primary((click)='save()', translate) Save
    button.btn.btn-danger((click)='cancel()', translate) Cancel
