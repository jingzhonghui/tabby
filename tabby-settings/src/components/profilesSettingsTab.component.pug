.profiles-workspace
    aside.group-sidebar
        .group-sidebar-header
            .group-sidebar-title 分组
            button.btn.btn-sm.btn-link.group-add-button((click)='newProfileGroup()', title='新建分组', aria-label='新建分组')
                i.fas.fa-plus

        button.group-item.group-item-all(
            type='button',
            [class.active]='selectedGroupId === "all"',
            [attr.aria-current]='selectedGroupId === "all" ? "page" : null',
            (click)='selectGroup("all")'
        )
            .group-icon
                i.fas.fa-server
            span.group-name 全部主机
            span.group-count {{ profiles.length }}

        .group-tree
            ng-container(*ngFor='let group of rootGroups')
                ng-container(*ngTemplateOutlet='recursiveGroup; context: {$implicit: group, depth: 0}')

        ng-template(#recursiveGroup let-group let-depth='depth')
            .group-item-wrap([style.--group-depth]='depth')
                button.group-expander(
                    type='button',
                    *ngIf='group.children?.length',
                    (click)='toggleGroupCollapse(group)',
                    [attr.aria-label]='getGroupToggleLabel(group)',
                    [attr.aria-expanded]='!group.collapsed'
                )
                    i.fas([class.fa-chevron-right]='group.collapsed', [class.fa-chevron-down]='!group.collapsed')
                .group-expander-placeholder(*ngIf='!group.children?.length')
                button.group-item(
                    type='button',
                    [class.active]='selectedGroupId === group.id',
                    [attr.aria-current]='selectedGroupId === group.id ? "page" : null',
                    (click)='selectGroup(group.id)'
                )
                    .group-icon
                        profile-icon([icon]='group.icon ?? "far fa-folder"', [color]='group.color')
                    span.group-name {{ getGroupName(group) }}
                    span.group-count {{ getGroupProfileCount(group) }}
                .group-actions(*ngIf='group.editable && group.name')
                    button.btn.btn-sm.btn-link((click)='editProfileGroup(group)', title='编辑分组', [attr.aria-label]='"编辑分组 " + group.name')
                        i.fas.fa-pencil-alt
                    button.btn.btn-sm.btn-link((click)='deleteProfileGroup(group)', title='删除分组', [attr.aria-label]='"删除分组 " + group.name')
                        i.fas.fa-trash-alt

            ng-container(*ngIf='!group.collapsed')
                ng-container(*ngFor='let child of group.children')
                    ng-container(*ngTemplateOutlet='recursiveGroup; context: {$implicit: child, depth: depth + 1}')

        .group-sidebar-footer
            label.sidebar-field-label(for='default-profile') 新标签默认配置
            select.form-control.form-control-sm#default-profile(
                [(ngModel)]='config.store.terminal.profile',
                (ngModelChange)='config.save()'
            )
                optgroup(label='自定义配置', *ngIf='customProfiles?.length > 0')
                    option(*ngFor='let profile of customProfiles', [ngValue]='profile.id') {{profile.name}}
                optgroup(label='内置配置')
                    option(*ngFor='let profile of builtinProfiles', [ngValue]='profile.id') {{profile.name}}

            button.btn.btn-outline-secondary.w-100.mt-2((click)='openAdvancedSettings()')
                i.fas.fa-sliders-h.me-2
                span 高级设置

    section.profile-panel
        .profile-panel-heading
            div
                h4.profile-panel-title {{ getSelectedGroupName() }}
                .profile-panel-subtitle 当前显示 {{ visibleProfiles.length }} 项，共 {{ selectedProfileCount }} 项

            .profile-toolbar
                .input-group.profile-search
                    .input-group-text
                        i.fas.fa-fw.fa-search
                    input.form-control(
                        type='search',
                        placeholder='搜索主机',
                        aria-label='搜索主机',
                        [(ngModel)]='filter',
                        (ngModelChange)='onFilterChange()'
                    )

                button.btn.btn-outline-primary.flex-shrink-0((click)='importProfiles()')
                    i.fas.fa-fw.fa-file-import
                    span.ms-1 导入

                div(ngbDropdown).d-inline-block.flex-shrink-0
                    button.btn.btn-outline-primary(ngbDropdownToggle)
                        i.fas.fa-fw.fa-file-export
                        span.ms-1 导出
                    div(ngbDropdownMenu)
                        button(ngbDropdownItem, (click)='exportProfiles(false)')
                            i.fas.fa-fw.fa-shield-halved
                            span 不含敏感信息
                        button(ngbDropdownItem, (click)='exportProfiles(true)')
                            i.fas.fa-fw.fa-key
                            span 包含密码和私钥

                button.btn.btn-primary.flex-shrink-0((click)='newProfile()')
                    i.fas.fa-fw.fa-plus
                    span.ms-1 新建配置

        .profile-list(*ngIf='visibleProfiles.length')
            .profile-row(
                *ngFor='let profile of visibleProfiles',
                [class.profile-row-readonly]='profile.isBuiltin',
                (click)='profile.isBuiltin ? null : editProfile(profile)'
            )
                .profile-main
                    profile-icon([icon]='profile.icon', [color]='profile.color')
                    .profile-copy
                        .profile-name-row
                            span.profile-name {{ profile.name }}
                            i.fas.fa-eye-slash.text-danger(*ngIf='isProfileBlacklisted(profile)')
                        .profile-description {{ getDescription(profile) || '暂无连接描述' }}

                .profile-group-path {{ getProfileGroupPath(profile) }}
                .profile-type(class='badge text-bg-{{getTypeColorClass(profile)}}') {{ getTypeLabel(profile) }}

                .profile-actions
                    button.btn.btn-sm.btn-link(*ngIf='!profile.isBuiltin', (click)='$event.stopPropagation(); editProfile(profile)', title='编辑', [attr.aria-label]='"编辑 " + profile.name')
                        i.fas.fa-pencil-alt
                    button.btn.btn-sm.btn-link((click)='$event.stopPropagation(); launchProfile(profile)', title='启动', [attr.aria-label]='"启动 " + profile.name')
                        i.fas.fa-play
                    div(ngbDropdown, placement='bottom-right top-right auto')
                        button.btn.btn-sm.btn-link(ngbDropdownToggle, (click)='$event.stopPropagation()', title='更多操作', [attr.aria-label]='profile.name + " 的更多操作"')
                            i.fas.fa-fw.fa-ellipsis-vertical
                        div(ngbDropdownMenu)
                            button.dropdown-item(ngbDropdownItem, (click)='$event.stopPropagation(); newProfile(profile)')
                                i.fas.fa-fw.fa-copy
                                span 复制
                            button.dropdown-item(ngbDropdownItem, *ngIf='profile.id && !isProfileBlacklisted(profile)', (click)='$event.stopPropagation(); blacklistProfile(profile)')
                                i.fas.fa-fw.fa-eye-slash
                                span 隐藏
                            button.dropdown-item(ngbDropdownItem, *ngIf='profile.id && isProfileBlacklisted(profile)', (click)='$event.stopPropagation(); unblacklistProfile(profile)')
                                i.fas.fa-fw.fa-eye
                                span 显示
                            button.dropdown-item(*ngIf='!profile.isBuiltin', (click)='$event.stopPropagation(); deleteProfile(profile)')
                                i.fas.fa-fw.fa-trash-alt
                                span 删除

        .profile-empty(*ngIf='!visibleProfiles.length')
            .profile-empty-icon
                i.fas([class.fa-search]='filter', [class.fa-server]='!filter')
            h5(*ngIf='filter') 没有匹配的主机
            h5(*ngIf='!filter') 当前分组暂无主机
            p.text-muted(*ngIf='filter') 请尝试其他搜索关键词
            button.btn.btn-primary(*ngIf='!filter && canCreateProfileInSelectedGroup()', (click)='newProfile()')
                i.fas.fa-plus
                span.ms-1 新建配置

ng-template(#advancedSettingsModal let-modal)
    .modal-header
        h4.modal-title#advanced-settings-title 高级设置
        button.btn-close(type='button', aria-label='关闭', (click)='modal.dismiss()')

    .modal-body.advanced-settings-modal
        .form-line.content-box(*ngIf='config.store.profiles.length > 0')
            .header
                .title 在选择器中显示最近使用的配置
                .description 设置为 0 可关闭最近使用记录
            input.form-control(
                type='number',
                min='0',
                step='1',
                [(ngModel)]='config.store.terminal.showRecentProfiles',
                (ngModelChange)='config.save()'
            )

        .form-line.content-box(*ngIf='config.store.profiles.length > 0')
            .header
                .title 在选择器中显示内置配置
                .description 关闭后，配置选择器中仅显示自定义配置
            toggle(
                [(ngModel)]='config.store.terminal.showBuiltinProfiles',
                (ngModelChange)='config.save()'
            )

        .form-line.content-box(*ngIf='hostApp.platform === Platform.Windows')
            .header
                .title 终端标识
                .description Tabby 通过环境变量向终端程序报告的类型
            select.form-control(
                [(ngModel)]='config.store.terminal.identification',
                (ngModelChange)='config.save()'
            )
                option(ngValue='wt') Windows Terminal
                option(ngValue='cygwin') Cygwin

        .form-line
            .header
                .title “连接到”的默认类型
                .description 快速连接功能默认使用的协议类型
            select.form-control(
                [(ngModel)]='config.store.defaultQuickConnectProvider',
                (ngModelChange)='config.save()'
            )
                option(*ngFor='let provider of getQuickConnectProviders()', [ngValue]='provider.id') {{getProviderName(provider)}}

        .advanced-defaults-title
            .fw-semibold 默认配置参数
            .text-muted 这些设置会应用到对应类型的所有配置

        .list-group.mt-3
            .list-group-item.d-flex.align-items-center(*ngFor='let provider of profileProviders')
                button.btn.btn-link.flex-grow-1.text-start.p-0((click)='editDefaults(provider)') {{getProviderName(provider)}}
                .me-auto
                button.btn.btn-link.ms-1((click)='$event.stopPropagation(); deleteDefaults(provider)', title='恢复默认设置')
                    i.fas.fa-trash-arrow-up

    .modal-footer
        button.btn.btn-primary(type='button', (click)='modal.close()') 完成
