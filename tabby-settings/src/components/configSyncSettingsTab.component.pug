h3.mb-3(translate) Config sync

ul.nav-tabs(ngbNav, #nav='ngbNav')
    li(ngbNavItem)
        a(ngbNavLink, translate) Sync
        ng-template(ngbNavContent)
            .form-line
                .header
                    .title(translate) Sync service
                    .description(translate) Where the configuration is stored

                select.form-control.w-50(
                    [(ngModel)]='config.store.configSync.backend',
                    (ngModelChange)='onBackendChange()'
                )
                    option(
                        *ngFor='let backend of availableBackends',
                        [value]='backend.id'
                    ) {{backend.name}}

            .form-line(*ngIf='needsHost')
                .header
                    .title(translate) Sync host

                .input-group.w-50
                    input.form-control(
                        type='text',
                        [(ngModel)]='config.store.configSync.host',
                        (keydown.enter)='config.save()',
                    )
                    button.btn.btn-secondary(
                        *ngIf='config.store.configSync.host',
                        (click)='openSyncHost()'
                    )
                        i.fas.fa-external-link-alt

            .form-line
                .header
                    .title(translate) Secret sync token
                    .description(*ngIf='needsHost', translate) Get it from the Tabby Web settings window
                    .description(*ngIf='!needsHost', translate) Personal access token with permission to manage code snippets

                .input-group
                    input.form-control(
                        type='password',
                        [(ngModel)]='config.store.configSync.token',
                        (change)='config.save(); testConnection()',
                        (keydown.enter)='config.save(); testConnection()'
                    )
                    button.btn.btn-secondary(
                        *ngIf='activeBackend?.tokenHelpUrl',
                        (click)='openTokenHelp()'
                    )
                        i.fas.fa-external-link-alt
                    .input-group-text(*ngIf='config.store.configSync.token')
                        i.fas.fa-fw.fa-circle-notch.fa-spin.text-warning(*ngIf='connectionSuccessful === null')
                        i.fas.fa-fw.fa-check.text-success(*ngIf='connectionSuccessful')
                        i.fas.fa-fw.fa-exclamation-triangle.text-danger(*ngIf='connectionSuccessful === false')

            .alert.alert-warning.d-flex.align-items-center(*ngIf='activeBackend?.publicReachable')
                .me-auto
                    span(translate) Code snippets are not private: anyone who obtains the snippet link can read it.
                    span.ms-1(translate) Enable Vault encryption before syncing anything sensitive.

            .alert.alert-info.d-flex.align-items-center(*ngIf='needsHost')
                .me-auto
                    span(translate) Config sync requires an instance of the Tabby Web service.
                    a.ml-1((click)='openTabbyWebInfo()', href='#', translate) Learn more

            ng-container(*ngIf='config.store.configSync.token')
                .alert.alert-danger(*ngIf='connectionSuccessful === false')
                    i.fas.fa-exclamation-triangle
                    span.ms-2(translate='Connection failed: {error}', [translateParams]='{error: connectionError?.message || connectionError}')

            ng-container(*ngIf='connectionSuccessful')
                .form-line
                    .header.d-flex.align-items-center
                        .title(translate) Configs
                        span.config-count.ms-2(*ngIf='configCount') {{configCount}}

                div(*ngIf='configs === null')
                    i.fas.fa-fw.fa-circle-notch.fa-spin
                    span.ms-2(translate) Loading configs...

                .list-group.list-group-light.config-list(*ngIf='configs !== null')
                    .list-group-item.config-row(
                        *ngFor='let cfg of configs',
                        [class.active]='isActiveConfig(cfg)'
                    )
                        .config-head
                            .config-state
                                i.fas.fa-check.text-success(*ngIf='isActiveConfig(cfg)')
                                i.fas.fa-cloud(*ngIf='!isActiveConfig(cfg)')

                            .config-name([title]='displayName(cfg)') {{displayName(cfg)}}
                            span.config-badge(*ngIf='activeBackend?.name') {{activeBackend.name}}
                            span.config-badge(*ngIf='cfg.last_used_with_version') v{{cfg.last_used_with_version}}

                            span.config-time(
                                translate='Modified on {date}',
                                [translateParams]='{date: cfg.modified_at|tabbyDate}'
                            )

                        .config-actions
                            button.config-action(
                                type='button',
                                (click)='uploadAndSync(cfg)',
                                [title]='uploadTitle(cfg)'
                            )
                                i.fas.fa-arrow-up
                                span.ms-1 {{uploadLabel(cfg)}}
                            button.config-action(
                                type='button',
                                (click)='downloadAndSync(cfg)',
                                [title]='"Download"|translate'
                            )
                                i.fas.fa-arrow-down
                                span.ms-1(translate) Download
                            button.config-action.danger(
                                type='button',
                                (click)='delete(cfg)',
                                [title]='"Delete"|translate'
                            )
                                i.fas.fa-trash
                                span.ms-1(translate) Delete
                            button.config-action(
                                type='button',
                                (click)='uploadAsNew()',
                                [title]='"Upload as a new config"|translate'
                            )
                                i.fas.fa-plus
                                span.ms-1(translate) Upload as a new config

            ng-container(*ngIf='hasMatchingRemoteConfig()')
                .form-line
                    .header
                        .title(translate) Sync automatically
                        .description(translate) Automatically upload changes and check for updates every minute

                    toggle(
                        [(ngModel)]='config.store.configSync.auto',
                        (ngModelChange)='config.save()',
                    )

    li(ngbNavItem)
        a(ngbNavLink, translate) Advanced
        ng-template(ngbNavContent)
            .alert.alert-info(*ngIf='config.store.encrypted')
                div(translate) Partial config sync is not possible when the config is encrypted via Vault.

            .form-line(*ngIf='!config.store.encrypted')
                .header
                    .title(translate) Sync hotkeys
                toggle(
                    [(ngModel)]='config.store.configSync.parts.hotkeys',
                    (ngModelChange)='config.save()',
                )

            .form-line(*ngIf='!config.store.encrypted')
                .header
                    .title(translate) Sync window settings
                toggle(
                    [(ngModel)]='config.store.configSync.parts.appearance',
                    (ngModelChange)='config.save()',
                )

            .form-line(*ngIf='!config.store.encrypted')
                .header
                    .title(translate) Sync Vault
                toggle(
                    [(ngModel)]='config.store.configSync.parts.vault',
                    (ngModelChange)='config.save()',
                )

div([ngbNavOutlet]='nav')
