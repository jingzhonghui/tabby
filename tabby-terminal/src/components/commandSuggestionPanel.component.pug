.suggestion-list(
    *ngIf='visible',
    [style.left.px]='position.left',
    [style.top.px]='position.top'
)
    .suggestion-item(
        *ngFor='let item of suggestions; let i = index; trackBy: trackByCommand',
        [class.selected]='i === selectedIndex',
        [title]='item',
        [attr.aria-label]='item',
        (mousedown)='$event.preventDefault(); accept(item)'
    )
        span.command {{item}}
    .suggestion-hint
        kbd ↑↓
        span(translate) select
        kbd Tab
        span(translate) to complete
        kbd Esc
        span(translate) to dismiss
